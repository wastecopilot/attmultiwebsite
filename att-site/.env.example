# ---------------------------------------------------------------------------
# Copy to .env.production (or enter in Vercel > Project > Settings > Environment
# Variables) and fill in REAL values before deploying. `npm run build` refuses to
# build if any required value is missing or looks like a placeholder.
# ---------------------------------------------------------------------------

# Order-line phone number exactly as it should be displayed, e.g. (877) 555-1234 format
NEXT_PUBLIC_PHONE_DISPLAY=
# Same number in E.164 format for tel: links, e.g. +18775551234 format
NEXT_PUBLIC_PHONE_TEL=

# Google tag: a GA4 measurement ID (G-XXXXXXXXXX) or a Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Google Ads account ID (AW-XXXXXXXXXX)
NEXT_PUBLIC_GADS_ID=
# Google Ads conversion label for phone-number clicks
NEXT_PUBLIC_GADS_CALL_LABEL=
# Optional: separate conversion label for "Calls from website" (number swap). Defaults to the call label.
NEXT_PUBLIC_GADS_SWAP_LABEL=

# Optional override: where the "Order Now" buttons go (full https:// URL). Leave empty to use the online
# order page /att/order?plan=<offer id>&source=<page>.
NEXT_PUBLIC_ORDER_URL=

# Optional, SERVER-SIDE ONLY (never prefix with NEXT_PUBLIC_): the order automation service (order-service/).
# Without both values the order page shows the plan and asks visitors to call.
# https address of order-service, e.g. https://orders.example.com
ATTSPOC_SERVICE_URL=
# Shared secret: the same random value (32+ characters) as ATTSPOC_SERVICE_KEY on order-service
ATTSPOC_SERVICE_KEY=
# Optional: seconds the order page waits for a quote / for the order request (default 240)
ATTSPOC_QUOTE_TIMEOUT_S=
ATTSPOC_HANDOFF_TIMEOUT_S=

# Optional: email address shown on the Contact page and in the footer (defaults to the address in src/data/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=
