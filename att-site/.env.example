# ---------------------------------------------------------------------------
# Copy to .env.production (or enter in Vercel > Project > Settings > Environment
# Variables) and fill in REAL values before deploying. `npm run build` refuses to
# build if any required value is missing or looks like a placeholder.
# ---------------------------------------------------------------------------

# Order-line phone number exactly as it should be displayed, e.g. (877) 555-1234 format
NEXT_PUBLIC_PHONE_DISPLAY=
# Same number in E.164 format for tel: links, e.g. +18775551234 format
NEXT_PUBLIC_PHONE_TEL=

# Google tag: a GA4 measurement ID (G-XXXXXXXXXX) or a Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Google Ads account ID (AW-XXXXXXXXXX)
NEXT_PUBLIC_GADS_ID=
# Google Ads conversion label for phone-number clicks
NEXT_PUBLIC_GADS_CALL_LABEL=
# Optional: separate conversion label for "Calls from website" (number swap). Defaults to the call label.
NEXT_PUBLIC_GADS_SWAP_LABEL=

# Optional: HTTPS endpoint that receives call-back requests as JSON (see HANDOVER.md). Empty = phone/email fallback.
NEXT_PUBLIC_LEAD_ENDPOINT=
# Optional: email address used by the form's email fallback (defaults to the address in src/data/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=
